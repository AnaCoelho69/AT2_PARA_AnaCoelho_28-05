   
    inteiro numero,positivos=0,negativos=0,zeros=0

    para(inteiro i = 1;i<=20;i++){
      escreva("Digite um número: ")
      leia(numero)

      se(numero >0){
        positivos = positivos+1
      }senao se(numero <0){
        negativos = negativos+1
      }senao{
        zeros=zeros+1
      }
    }
    escreva("\n----------\n--Quantidade de números:\nPositivos: ",positivos,"\nNegativos: ",negativos,"\nZeros: ",zeros)
